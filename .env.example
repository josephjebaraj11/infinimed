# --- Runtime -----------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public origin patients, EHRs and webhooks reach. Must be https in production. Every OAuth
# redirect URI, JWKS URL, SMART launch URL and CDS Hooks URL is derived from it.
PUBLIC_URL=http://localhost:4000
# Where the dashboard is served from in development (vite dev server).
DASHBOARD_URL=http://localhost:5173

# --- Database ----------------------------------------------------------------------------------
# PostgreSQL in production. When unset (development only), an embedded PGlite database is used
# under DATA_DIR/pglite.
# DATABASE_URL=postgres://infinimed:infinimed-dev@localhost:5432/infinimed
DATA_DIR=.data

# --- Secrets (required in production) ------------------------------------------------------------
# Generate both with: pnpm --filter @infinimed/server keys:generate
# MASTER_KEY=base64-encoded-32-bytes
# SIGNING_KEYS_JSON='[{"kty":"RSA",...}]'

# --- Managed credentials -----------------------------------------------------------------------
# InfiniMed's own app registrations with each vendor, used when a workspace has not switched a
# connection to custom credentials. Shape: { vendor: { sandbox|production: { client_id,
# client_secret?, token_auth_method?, scopes?, surfaces?: { clinical_workflow|backend: {...} } } } }
# MANAGED_CREDENTIALS_JSON='{"epic":{"sandbox":{"client_id":"...","token_auth_method":"private_key_jwt"}}}'
# MANAGED_CREDENTIALS_FILE=/run/secrets/managed-credentials.json

# --- Workers -----------------------------------------------------------------------------------
# Run the job worker inside the API process (simple deployments) or separately (worker-main.ts).
WORKER_INLINE=true
WORKER_CONCURRENCY=4
RECORD_PULL_INTERVAL_HOURS=24

# --- Network safety ----------------------------------------------------------------------------
# Customer-supplied URLs (webhooks, exports, CDS) may not reach private networks in production.
# ALLOW_PRIVATE_NETWORK_EGRESS=false

LOG_LEVEL=info
