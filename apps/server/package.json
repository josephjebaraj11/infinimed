{
  "name": "@infinimed/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker-main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "keys:generate": "tsx src/scripts/generate-keys.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "catalog:import": "tsx --env-file-if-exists=../../.env src/scripts/catalog-import.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@electric-sql/pglite": "0.5.11",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
