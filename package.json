{
  "name": "infinimed",
  "private": true,
  "version": "0.1.0",
  "description": "InfiniMed: one integration layer for patient access, clinician workflow, backend and network healthcare data.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @infinimed/server dev",
    "dev:dashboard": "pnpm --filter @infinimed/dashboard dev",
    "db:generate": "pnpm --filter @infinimed/server db:generate",
    "db:migrate": "pnpm --filter @infinimed/server db:migrate"
  }
}
